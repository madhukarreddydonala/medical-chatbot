# Required provider credentials. Keep real credentials in .env only.
GROQ_API_KEY=your-groq-api-key
PINECONE_API_KEY=your-pinecone-api-key

# Pinecone index settings; the index is created by store_index.py when missing.
PINECONE_INDEX_NAME=medical-bot
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# Optional namespace. Use the same value during indexing and chat.
PINECONE_NAMESPACE=

# Groq production model currently listed by Groq; override if your account uses another model.
GROQ_MODEL=openai/gpt-oss-120b

# The default model outputs 384-dimensional vectors. Use this same model at index and query time.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVER_K=4

# Optional local server settings.
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
