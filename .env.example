# Pinecone credentials stay on the Python backend, not in the browser.
PINECONE_API_KEY=your_pinecone_api_key

# Pinecone settings (the index must use 384 dimensions for the default model).
PINECONE_INDEX_NAME=medical-bot
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# Optional: use the same namespace when indexing and chatting.
# PINECONE_NAMESPACE=

# Optional model and app settings.
GROQ_MODEL=openai/gpt-oss-120b
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVER_K=4
# PDF_DATA_DIR=data
HOST=127.0.0.1
PORT=5000
# Keep debug disabled except for local development.
FLASK_DEBUG=0

# On the deployed Python backend, set these separately in its secret manager:
# NETLIFY_PROXY_TOKEN=generate-a-long-random-secret
# REQUIRE_NETLIFY_PROXY=1
